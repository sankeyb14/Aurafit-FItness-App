rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS collection: users can read/write their own document
    match /USERS/{userId} {
      allow read, write: if isOwner(userId);
    }

    // WORKOUT_PLANS collection: users can read/write their own plans
    match /WORKOUT_PLANS/{planId} {
      allow read, create, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // DAILY_LOGS collection: users can read/write their own daily logs
    match /DAILY_LOGS/{logId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // EXERCISE_DATABASE collection: publicly readable, admin writeable
    match /EXERCISE_DATABASE/{exerciseId} {
      allow read: if true;
      allow write: if false;
    }

    // ANALYTICS collection: user readable and writeable
    match /ANALYTICS/{analyticsId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
